{
  "name": "@asap/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "start": "tsx src/http.ts",
    "start:stdio": "tsx src/stdio.ts",
    "build": "node build.mjs",
    "start:dist": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@asap/db": "workspace:*",
    "@asap/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "bin": {
    "asapawge-mcp": "./dist/stdio.js"
  }
}
