# ──────────────────────────────────────────────────────────────
# ASAPawge GG — environment. Copy to `.env` (root) and adjust.
# apps/web, apps/mcp, packages/db read the ROOT .env (see apps/web/next.config.ts).
# Every key below is OPTIONAL in local dev unless marked REQUIRED:
# missing provider keys => sandbox/mock mode (clearly labelled in the UI/logs).
# ──────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
# Public base URL of the web app (used in payment redirects, emails, sitemap)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# REQUIRED. PostgreSQL 16 (pg_trgm extension is created by the first migration)
DATABASE_URL=postgresql://asap:asap@localhost:5432/asapawge
# REQUIRED. Redis 7 (rate limit, locks, cache, arq queue)
REDIS_URL=redis://localhost:6379

# ── Auth.js v5 ────────────────────────────────────────────────
# REQUIRED. `openssl rand -base64 32`
AUTH_SECRET=dev-only-auth-secret-change-me-please-0123456789
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# ── Stock encryption (AES-256-GCM) ────────────────────────────
# REQUIRED. 32 bytes, base64 or 64 hex chars. `openssl rand -base64 32`
# Shared by web (TS) and worker (Python). The value below is DEV ONLY. Changing it makes existing stock undecryptable!
STOCK_ENCRYPTION_KEY=ZGV2LW9ubHktc3RvY2sta2V5LTMyLWJ5dGVzLWxvbiE=

# ── Payments ──────────────────────────────────────────────────
# Without keys the SANDBOX provider is used (fake checkout page + signed fake webhook).
# Values must be checked against the providers' current API docs before production.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_URL=https://app.platega.io
ROLLYPAY_API_KEY=
ROLLYPAY_SECRET=
ROLLYPAY_API_URL=https://api.rollypay.io
# Secret used to sign sandbox webhooks (dev only)
SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret
# 1/0 forces the sandbox ("Тестовая оплата") on/off. Empty => on in dev, and in prod only while no real gateway is configured.
ALLOW_SANDBOX_PAYMENTS=
# Platega overrides (verify against current Platega docs before production)
PLATEGA_CREATE_PATH=/transaction/process
PLATEGA_STATUS_PATH=/transaction/{id}
PLATEGA_MERCHANT_HEADER=X-MerchantId
PLATEGA_SECRET_HEADER=X-Secret
# numeric paymentMethod ids of the merchant account: SBP / bank cards
PLATEGA_METHOD_SBP=2
PLATEGA_METHOD_CARD=10
# RollyPay overrides (verify against current RollyPay docs before production)
ROLLYPAY_CREATE_PATH=/v1/invoices
ROLLYPAY_STATUS_PATH=/v1/invoices/{id}
ROLLYPAY_AUTH_HEADER=Authorization
ROLLYPAY_SIGNATURE_HEADER=x-signature

# ── AI ────────────────────────────────────────────────────────
# Provider chain: first configured one wins; mock provider is used when no key is set.
# AI_PROVIDER = openai | anthropic | openrouter | mock
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Analytics ─────────────────────────────────────────────────
# Yandex Metrika counter id (also editable in admin settings)
NEXT_PUBLIC_YM_ID=

# ── Worker (FastAPI + arq) ────────────────────────────────────
WORKER_URL=http://localhost:8000
# Shared secret: web -> worker  `Authorization: Bearer <token>` on /internal/*
WORKER_INTERNAL_TOKEN=dev-internal-token-change-me
# Worker -> web callbacks (if any)
WEB_INTERNAL_URL=http://localhost:3000

# ── Steam top-up supplier (AUTO_PROVIDER delivery) ────────────
# mock | http
STEAM_TOPUP_PROVIDER=mock
STEAM_TOPUP_API_URL=
STEAM_TOPUP_API_KEY=

# ── MCP server (apps/mcp) ─────────────────────────────────────
MCP_PORT=3333
# REST API base used by the MCP server (talks to web /api/v1 with the caller's API key)
MCP_API_BASE_URL=http://localhost:3000/api/v1

# ── Business defaults (can be overridden in admin Settings) ───
COMMISSION_DEFAULT_BPS=1000
HOLD_DAYS=3

# ── Docker compose helpers ────────────────────────────────────
POSTGRES_USER=asap
POSTGRES_PASSWORD=asap
POSTGRES_DB=asapawge
